{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "development": {
      "pnpm": "12.21.0",
      "env": {
        "pnpm_config_dangerously_allow_all_builds": "true",
        "pnpm_config_node_linker": "hoisted"
      },
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "pnpm": "12.21.0",
      "env": {
        "pnpm_config_dangerously_allow_all_builds": "true",
        "pnpm_config_node_linker": "hoisted"
      },
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "pnpm": "12.21.0",
      "env": {
        "pnpm_config_dangerously_allow_all_builds": "true",
        "pnpm_config_node_linker": "hoisted"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}